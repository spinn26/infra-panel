# Обязательно: сильный пароль
ADMIN_USER=admin
ADMIN_PASSWORD=

# Подпись сессий (необязательно — генерируется при старте)
# PANEL_SECRET=

# Пути на ХОСТЕ (подставьте свои)
HOST_DEPLOY_HOST=/opt/fleet/deploy
HOST_BACKUPS_DIR=/opt/fleet/backups
HOST_PUBLIC_IP=

# gid группы docker на хосте: узнать командой `getent group docker`
DOCKER_GID=985
